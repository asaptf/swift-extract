diff --git a/Sources/AnyLanguageModel/Shared/ConstrainedGenerationProbe.swift b/Sources/AnyLanguageModel/Shared/ConstrainedGenerationProbe.swift
new file mode 100644
index 0000000..439b03c
--- /dev/null
+++ b/Sources/AnyLanguageModel/Shared/ConstrainedGenerationProbe.swift
@@ -0,0 +1,165 @@
+import Foundation
+
+/// Temporary diagnostic counters for guided-generation probes.
+///
+/// Not part of the stable public API — used by a one-off harness probe to dump
+/// escape-hatch / empty-object behaviour. Safe to leave at zero cost when unused
+/// (locked counters, no logging unless the probe reads a snapshot).
+public enum ConstrainedGenerationProbe: Sendable {
+    public struct Snapshot: Sendable, CustomStringConvertible {
+        /// Total `generateChoice` calls that took the deterministic escape hatch.
+        public var escapeHatchTotal: Int = 0
+        /// Escape hatches where candidates looked like object key starts (`"key":` / `,"key":`)
+        /// plus optional `}` — i.e. the property-selection path, not string enums.
+        public var escapeHatchPropertyChoice: Int = 0
+        /// Subset of property-choice escapes that occurred at object nesting depth 0 (root).
+        public var escapeHatchRootKeySet: Int = 0
+        public var escapeHatchEmptyCandidate: Int = 0
+        public var escapeHatchPrefixCollision: Int = 0
+        /// Root object chose `}` before emitting any property (schema had empty `required`).
+        public var rootObjectImmediateClose: Int = 0
+        /// How many times the root object offered a key-set choice (including close).
+        public var rootObjectKeyChoiceSteps: Int = 0
+        /// Nested object immediate closes (all-optional nested structs).
+        public var nestedObjectImmediateClose: Int = 0
+        /// Completion tokens consumed by the last guided generate (budget − remaining).
+        public var guidedCompletionTokens: Int?
+        /// Completion tokens from the last unconstrained MLX stream (`.info`).
+        public var baselineCompletionTokens: Int?
+        /// Brief event log (escape hatch + immediate close).
+        public var events: [String] = []
+
+        public var description: String {
+            var lines: [String] = []
+            lines.append(
+                "escapeHatchTotal=\(escapeHatchTotal) (empty=\(escapeHatchEmptyCandidate) prefixCollision=\(escapeHatchPrefixCollision))"
+            )
+            lines.append(
+                "escapeHatchPropertyChoice=\(escapeHatchPropertyChoice) rootKeySet=\(escapeHatchRootKeySet)"
+            )
+            lines.append(
+                "rootObjectKeyChoiceSteps=\(rootObjectKeyChoiceSteps) rootImmediateClose=\(rootObjectImmediateClose) nestedImmediateClose=\(nestedObjectImmediateClose)"
+            )
+            if let g = guidedCompletionTokens {
+                lines.append("guidedCompletionTokens=\(g)")
+            }
+            if let b = baselineCompletionTokens {
+                lines.append("baselineCompletionTokens=\(b)")
+            }
+            if !events.isEmpty {
+                lines.append("events:")
+                for e in events.prefix(40) {
+                    lines.append("  \(e)")
+                }
+                if events.count > 40 {
+                    lines.append("  … (\(events.count - 40) more)")
+                }
+            }
+            return lines.joined(separator: "\n")
+        }
+    }
+
+    private static let lock = NSLock()
+    nonisolated(unsafe) private static var state = Snapshot()
+
+    public static func reset() {
+        lock.lock()
+        state = Snapshot()
+        lock.unlock()
+    }
+
+    public static func snapshot() -> Snapshot {
+        lock.lock()
+        defer { lock.unlock() }
+        return state
+    }
+
+    static func recordEscape(
+        hasEmptyCandidate: Bool,
+        hasPrefixCollision: Bool,
+        candidates: [String],
+        chosen: String,
+        objectDepth: Int?
+    ) {
+        lock.lock()
+        defer { lock.unlock() }
+        state.escapeHatchTotal += 1
+        if hasEmptyCandidate { state.escapeHatchEmptyCandidate += 1 }
+        if hasPrefixCollision { state.escapeHatchPrefixCollision += 1 }
+
+        let isPropertyChoice =
+            candidates.contains(where: { looksLikePropertyStart($0) })
+            || candidates.contains("}")
+        if isPropertyChoice {
+            state.escapeHatchPropertyChoice += 1
+            if objectDepth == 0 {
+                state.escapeHatchRootKeySet += 1
+            }
+        }
+
+        let reason: String
+        switch (hasEmptyCandidate, hasPrefixCollision) {
+        case (true, true): reason = "empty+prefixCollision"
+        case (true, false): reason = "empty"
+        case (false, true): reason = "prefixCollision"
+        case (false, false): reason = "unknown"
+        }
+        let depthLabel = objectDepth.map { "depth=\($0)" } ?? "depth=?"
+        let preview = candidates.prefix(8).map { truncate($0, 40) }.joined(separator: " | ")
+        state.events.append(
+            "ESCAPE[\(reason) \(depthLabel)] chosen=\(truncate(chosen, 40)) from [\(preview)] (n=\(candidates.count))"
+        )
+    }
+
+    static func recordObjectKeyChoiceStep(depth: Int, canClose: Bool, keyCount: Int) {
+        lock.lock()
+        defer { lock.unlock() }
+        if depth == 0 {
+            state.rootObjectKeyChoiceSteps += 1
+        }
+        // Keep event volume low — only first few root steps
+        if depth == 0 && state.rootObjectKeyChoiceSteps <= 5 {
+            state.events.append(
+                "ROOT_KEY_STEP #\(state.rootObjectKeyChoiceSteps) keysRemaining=\(keyCount) canClose=\(canClose)"
+            )
+        }
+    }
+
+    static func recordImmediateClose(depth: Int) {
+        lock.lock()
+        defer { lock.unlock() }
+        if depth == 0 {
+            state.rootObjectImmediateClose += 1
+            state.events.append("ROOT_IMMEDIATE_CLOSE {}")
+        } else {
+            state.nestedObjectImmediateClose += 1
+            state.events.append("NESTED_IMMEDIATE_CLOSE depth=\(depth)")
+        }
+    }
+
+    static func recordGuidedCompletionTokens(_ n: Int) {
+        lock.lock()
+        defer { lock.unlock() }
+        state.guidedCompletionTokens = n
+    }
+
+    /// Public so MLXLanguageModel (same module) and external probes can record baseline usage.
+    public static func recordBaselineCompletionTokens(_ n: Int) {
+        lock.lock()
+        defer { lock.unlock() }
+        state.baselineCompletionTokens = n
+    }
+
+    private static func looksLikePropertyStart(_ s: String) -> Bool {
+        // `"key":` or `,"key":`
+        if s.hasPrefix(",\"") || s.hasPrefix("\"") {
+            return s.hasSuffix("\":")
+        }
+        return false
+    }
+
+    private static func truncate(_ s: String, _ max: Int) -> String {
+        if s.count <= max { return s }
+        return String(s.prefix(max)) + "…"
+    }
+}
