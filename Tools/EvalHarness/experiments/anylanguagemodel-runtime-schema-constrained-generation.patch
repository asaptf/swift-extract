+        maps.textToTokens[",\"x\":"] = [comma, quote, x, quote, colon]
+        maps.textToTokens[",\"y\":"] = [comma, quote, y, quote, colon]
+        maps.textToTokens[",\"z\":"] = [comma, quote, z, quote, colon]
