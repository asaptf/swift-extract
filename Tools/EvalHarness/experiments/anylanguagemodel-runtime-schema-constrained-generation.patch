+            properties: [
+                "x": stringNode,
+                "y": stringNode,
+                "z": stringNode,
+            ],
+            required: []
+        )
+        // Type argument is unused; only the node shapes generation.
+        return GenerationSchema.primitive(String.self, node: .object(objectNode))
+    }
